 }
 
+// replicationInitPending reports whether a deferred replication
+// initialization is pending.
+func (ts *tmState) replicationInitPending() bool {
+	ts.mu.Lock()
+	defer ts.mu.Unlock()
+	return ts.pendingReplicationInit != 0
+}
