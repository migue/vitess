+package tabletmanager
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"vitess.io/vitess/go/vt/logutil"
+	"vitess.io/vitess/go/vt/mysqlctl"
+	topodatapb "vitess.io/vitess/go/vt/proto/topodata"
+)
+
+func TestStartupFailsWhileTheShardIsLocked(t *testing.T) {
+	tm, md, ts, _ := newReplicationInitializationTM(t)
+	holdInitializationShardLock(t, ts)
+	md.ExpectedExecuteSuperQueryList = nil
+
+	_, err := tm.initializeReplicationUnlessShardLocked(t.Context(), logutil.NewMemoryLogger(), topodatapb.TabletType_REPLICA)
+	_, unavailable := errors.AsType[*shardLockUnavailableError](err)
+	assert.True(t, unavailable, "err=%v", err)
+	assert.False(t, tm.tmState.replicationInitPending(), "nothing retries in the background")
+	assert.False(t, md.Replicating)
+}
+
+func TestRestartAfterRestoreInitializesReplication(t *testing.T) {
+	tm, md, _, _ := newReplicationInitializationTM(t)
+	tm.Cnf = &mysqlctl.Mycnf{}
+
+	// mysqld already has the restored data, so the restore is skipped.
+	started, err := tm.newRestoreStateManager(logutil.NewMemoryLogger(), false).start(t.Context())
+	require.NoError(t, err)
+	assert.False(t, started)
+	require.NoError(t, md.CheckSuperQueryList(), "the restart initializes replication")
+	assert.True(t, md.Replicating)
+	assert.Equal(t, "old-primary", md.CurrentSourceHost)
+}
+
+func TestRestartAfterRestoreFailsWhileTheShardIsLocked(t *testing.T) {
+	tm, md, ts, _ := newReplicationInitializationTM(t)
+	tm.Cnf = &mysqlctl.Mycnf{}
+	holdInitializationShardLock(t, ts)
+	md.ExpectedExecuteSuperQueryList = nil
+
+	_, err := tm.newRestoreStateManager(logutil.NewMemoryLogger(), false).start(t.Context())
+	require.ErrorContains(t, err, "cannot initialize replication for ks/0")
+	assert.False(t, md.Replicating)
+}
+
+func TestRestoreFailsWhileTheShardIsLocked(t *testing.T) {
+	tm, md, ts, _ := newReplicationInitializationTM(t)
+	tm.Cnf = &mysqlctl.Mycnf{}
+	require.NoError(t, tm.tmState.ChangeTabletType(t.Context(), topodatapb.TabletType_RESTORE, DBActionNone))
+	holdInitializationShardLock(t, ts)
+
+	md.ExpectedExecuteSuperQueryList = []string{"STOP REPLICA", "FAKE RESET REPLICA ALL"}
+	rsm := tm.newRestoreStateManager(logutil.NewMemoryLogger(), true)
+	rsm.state = restoreStarted
+	rsm.prevTabletType, rsm.nextTabletType = topodatapb.TabletType_REPLICA, topodatapb.TabletType_REPLICA
+	pos := md.GetPrimaryPositionLocked()
+	err := rsm.finish(t.Context(), replicationCommand{action: replicationActionStart, position: &pos})
+	require.ErrorContains(t, err, "cannot initialize replication for ks/0")
+	require.NoError(t, md.CheckSuperQueryList())
+	assert.False(t, md.Replicating)
+	assert.Equal(t, topodatapb.TabletType_RESTORE, tm.Tablet().Type, "the tablet stays out of rotation")
+	assert.False(t, tm.tmState.replicationInitPending())
+}
diff --git a/go/vt/vttablet/tabletmanager/tm_init.go b/go/vt/vttablet/tabletmanager/tm_init.go
index e1869d923a..539d628b92 100644
--- a/go/vt/vttablet/tabletmanager/tm_init.go
+++ b/go/vt/vttablet/tabletmanager/tm_init.go
@@ -1199,17 +1199,13 @@ const (
 	replicationInitializationMaxRetryInterval = time.Minute
 )
 
-// initializeReplicationUnlessShardLocked initializes replication unless the
-// shard lock is unavailable. In that case replication is left unchanged, and
-// initialization is retried in the background while non-primary types do not
-// serve queries.
+// initializeReplicationUnlessShardLocked initializes replication. If the shard
+// lock is unavailable, it returns the error without changing replication: at
+// startup vttablet then exits, and a restore fails, leaving the tablet RESTORE.
 func (tm *TabletManager) initializeReplicationUnlessShardLocked(ctx context.Context, logger logutil.Logger, tabletType topodatapb.TabletType) (string, error) {
 	primaryPos, err := tm.initializeReplication(ctx, tabletType)
 	if _, ok := errors.AsType[*shardLockUnavailableError](err); ok {
-		logger.Warningf("deferring replication initialization, retrying in the background: %v", err)
-		id := tm.tmState.deferReplicationInit(ctx, err)
-		go tm.retryReplicationInitialization(tm.tmState.ctx, id)
-		return "", nil
+		logger.Errorf("cannot initialize replication while another operation holds the shard lock: %v", err)
 	}
 	return primaryPos, err
 }
